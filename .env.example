# ============================================================
# YUMYUMPO — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
#
# For Vercel: add these in the Vercel Dashboard → Settings → Environment Variables
# ============================================================

# ── SUPABASE ──────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# ── GOOGLE MAPS (optional) ────────────────────────────────────
# Get from: Google Cloud Console → Maps JavaScript API
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY

# ── CLAUDE AI (future integration) ───────────────────────────
# Get from: Anthropic Console → API Keys
# NOTE: NEVER expose this key on the frontend.
# Use a serverless function (Vercel API route or Supabase Edge Function) as a proxy.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# ── APP CONFIG ────────────────────────────────────────────────
APP_NAME=YUMYUMPO
APP_URL=https://yumyumpo.vercel.app
